# SmartLogistics Practice environment variables

# PostgreSQL Auth (MS-Identity)
AUTH_POSTGRES_DB=auth_db
AUTH_POSTGRES_USER=auth
AUTH_POSTGRES_PASSWORD=change-this-auth-password
AUTH_POSTGRES_PORT=5433

# PostgreSQL Warehouse (WarehouseCore)
WAREHOUSE_POSTGRES_DB=warehouse_db
WAREHOUSE_POSTGRES_USER=warehouse
WAREHOUSE_POSTGRES_PASSWORD=change-this-warehouse-password
WAREHOUSE_POSTGRES_PORT=5432

# Redis (RobotStatus)
REDIS_PORT=6379

# MongoDB (LogisticsAnalytics)
MONGO_DB=logistics_analytics
MONGO_PORT=27017

# RabbitMQ
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_STOMP_PORT=15674
RABBITMQ_USER=smartlogistics
RABBITMQ_PASSWORD=change-this-rabbitmq-password

# JWT
JWT_SECRET=change-this-jwt-secret-before-starting

# Nginx
NGINX_PORT=8080

# Microservicios
IDENTITY_PORT=8084
WAREHOUSE_CORE_PORT=8081
ROBOT_STATUS_PORT=8082
ANALYTICS_PORT=8083

# Observabilidad
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-this-grafana-password
LOKI_PORT=3100

# Jaeger
JAEGER_UI_PORT=16686
JAEGER_OTLP_HTTP_PORT=4318
JAEGER_OTLP_GRPC_PORT=4317
